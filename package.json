{
  "name": "bite-point",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "description": "Open-source six-speed manual driving simulator with 250 Hz vehicle physics, clutch simulation and a 6 km proving straight",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/richie-rich90454/bite-point.git"
  },
  "bugs": {
    "url": "https://github.com/richie-rich90454/bite-point/issues"
  },
  "homepage": "https://github.com/richie-rich90454/bite-point#readme",
  "keywords": [
    "driving-simulator",
    "manual-transmission",
    "vehicle-physics",
    "babylonjs",
    "typescript",
    "webgl"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@babylonjs/core": "^9.32.0",
    "@babylonjs/loaders": "^9.32.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "eslint": "^10.13.0",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
